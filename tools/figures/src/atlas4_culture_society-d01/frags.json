{
 "t1": [
  "Aseptic collection of",
  "tissue (biopsy, embryo)"
 ],
 "t2": [
  "Disaggregate: mechanical,",
  "trypsin or collagenase"
 ],
 "t3": [
  "Seed cells in medium",
  "+ serum in flask/dish"
 ],
 "t4": [
  "Incubate 37 °C, 5% CO₂,",
  "humid; cells attach"
 ],
 "t5": [
  "Monitor daily; change",
  "medium every 2‑3 days"
 ],
 "t6": [
  "Confluent: trypsinise",
  "and subculture (passage)"
 ],
 "t7": [
  "Characterise; test for",
  "mycoplasma"
 ],
 "t8": [
  "Cryopreserve in 10% DMSO",
  "in liquid N₂ (−196 °C)"
 ]
}