   "title": {
    "en": "Animal Cell Culture: Workflow, Requirements and Media"
   },
   "blocks": [
    {
     "type": "p",
     "text": {
      "en": "Culture means growing cells outside the animal under controlled, sterile conditions."
     }
    },
    {
     "type": "callout",
     "kind": "info",
     "text": {
      "en": "Animal cell culture\nGrowth of cells dissociated from animal tissue, in a vessel with a defined medium, at 37 °C, pH 7.2–7.4 and 5% CO₂, under aseptic conditions."
     }
    },
