  {
   "id": "s05",
   "title": {
    "en": "BLAST: How Database Searching Works"
   },
   "blocks": [
    {
     "type": "p",
     "text": {
      "en": "BLAST trades the full dynamic-programming guarantee for speed by seeding with short words."
     }
    },
    {
     "type": "diagram",
     "id": "atlas5_bioinformatics-d06",
     "caption": {
      "en": "Fig. 6. Seed, extend and score (Altschul _et al._ 1990)."
     },
     "labels": [
      "Query sequence;",
      "choose program and",
      "database",
      "Split query into words",
      "(k = 3 aa or 11 nt)",
      "Find neighbourhood",
      "words scoring ≥ T in the",
      "substitution matrix",
      "Scan database for exact",
      "word hits (seeds)",
      "Extend hits both ways",
      "(two-hit method) into",
      "HSPs (X-drop)",
      "Compute bit score and",
      "E-value; rank hits",
      "Report: alignment,",
      "identity, coverage,",
      "E-value"
